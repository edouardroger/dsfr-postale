{
  "name": "dsfr-postale",
  "version": "2.2.0",
  "description": "Composant Vue adoptant le système de design de l'État et proposant une autocomplétion d'adresse postale grâce à l'API « Géocodage » de l'IGN",
  "keywords": [
    "vue",
    "dsfr",
    "adresse",
    "autocomplete",
    "combobox",
    "ban",
    "geoplateforme",
    "rgaa"
  ],
  "author": "Édouard Roger",
  "license": "MIT",
  "homepage": "https://edouardroger.github.io/dsfr-postale/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edouardroger/dsfr-postale.git"
  },
  "bugs": "https://github.com/edouardroger/dsfr-postale/issues",
  "type": "module",
  "main": "./dist/dsfr-postale.umd.cjs",
  "module": "./dist/dsfr-postale.es.js",
  "types": "./dist/types/index.d.ts",
  "style": "./dist/dsfr-postale.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dsfr-postale.es.js",
      "require": "./dist/dsfr-postale.umd.cjs"
    },
    "./style.css": "./dist/dsfr-postale.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --mode demo --port 4173 --strictPort",
    "typecheck": "vue-tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:umd": "node scripts/check-umd.cjs",
    "check": "npm run typecheck && npm run test:coverage && npm run build && npm run test:umd && npm run build:demo"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "minimatch": "^10.2.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
